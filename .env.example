# Supabase (Dashboard → Connect / Settings → API Keys)
# Use the new publishable + secret keys (not legacy anon / service_role JWTs)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-only — never expose to the browser
SUPABASE_SECRET_KEY=sb_secret_...

# Shared secret for Python agent enroll (generate a long random string)
AGENT_ENROLL_SECRET=change-me-long-random

# Optional: pin enroll to a specific auth user UUID (otherwise first profile)
# HUDL_OWNER_USER_ID=

# Optional: self-hosted RustDesk web client base URL (Phase 2)
# NEXT_PUBLIC_RUSTDESK_WEB_URL=https://rustdesk.example.com
